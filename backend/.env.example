# Copiar este archivo a .env y definir credenciales reales de PostgreSQL 17 (OWASP A04)
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=cambiar-por-clave-aleatoria-segura-de-64-caracteres
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Base de Datos PostgreSQL 17 (obligatorio, sin SQLite ni JSON)
DB_NAME=clinica_del_pc
DB_USER=postgres
DB_PASSWORD=tu_password_postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=prefer

# Orígenes CORS / CSRF para frontend desacoplado
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5500,http://localhost:5500
